{
  "name": "fleet-dao",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=22.22"
  },
  "scripts": {
    "check": "biome check . && tsc -b && vitest run && node packages/hygiene/src/bin/check.ts && node packages/conventions/src/bin/debt-check.ts",
    "hygiene": "node packages/hygiene/src/bin/check.ts",
    "prepare": "node packages/hygiene/src/bin/install-hooks.ts",
    "format": "biome check --write .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "issue:new": "node packages/conventions/src/bin/issue-new.ts",
    "debt:check": "node packages/conventions/src/bin/debt-check.ts",
    "milestone:close-check": "node packages/conventions/src/bin/milestone-close-check.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/node": "^22.20.4",
    "esbuild": "0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
