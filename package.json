{
  "name": "fleet-dao",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.28.2",
  "engines": {
    "node": ">=22.22"
  },
  "scripts": {
    "dev": "pnpm --filter @fleet-dao/web dev:mock",
    "start": "node packages/db/src/bin/local-pg.ts start",
    "stop": "node packages/db/src/bin/local-pg.ts stop",
    "check": "node packages/conventions/src/bin/check.ts",
    "hygiene": "node packages/hygiene/src/bin/check.ts",
    "prepare": "node packages/hygiene/src/bin/install-hooks.ts",
    "format": "biome check --write .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "agents:sync": "node packages/agents-sync/bin/agents-sync-now",
    "mirasim:migrate": "node packages/mirasim-reclaude/bin/migrate",
    "mirasim:health": "node packages/mirasim-reclaude/bin/health",
    "mirasim:audit": "node packages/mirasim-reclaude/bin/audit",
    "test:changed": "node packages/conventions/src/bin/test-changed.ts",
    "ci:timings": "node packages/conventions/src/bin/ci-timings.ts",
    "ci:stats": "node packages/conventions/src/bin/ci-stats.ts",
    "flow:stats": "node packages/conventions/src/bin/flow-stats.ts",
    "issue:new": "node packages/conventions/src/bin/issue-new.ts",
    "progress": "node packages/conventions/src/bin/progress.ts",
    "issue:close": "node packages/conventions/src/bin/issue-close.ts",
    "debt:check": "node packages/conventions/src/bin/debt-check.ts",
    "deps:check": "node packages/conventions/src/bin/deps-check.ts",
    "release:smoke": "bash deploy/release-smoke.sh",
    "decisions:index": "node packages/conventions/src/bin/decisions-index.ts",
    "plan": "node packages/conventions/src/bin/plan.ts",
    "github:audit": "node packages/conventions/src/bin/github-audit.ts",
    "branch:hygiene": "node packages/conventions/src/bin/branch-hygiene.ts",
    "release:onekey": "node agents/skills/commander/scripts/release-onekey.mjs",
    "pr:open": "node packages/conventions/src/bin/pr-open.ts",
    "project": "node packages/conventions/src/bin/project.ts",
    "project:add": "node packages/conventions/src/bin/project.ts add",
    "project:check": "node packages/conventions/src/bin/project.ts check",
    "work": "node packages/conventions/src/bin/work.ts",
    "line:stats": "node packages/db/src/bin/line-stats.ts",
    "repo:check": "node agents/hooks/repo-contract.mjs check",
    "repo:init": "node agents/hooks/repo-contract.mjs init",
    "local-sessions": "node agents/local-sessions/install.mjs",
    "agent-eval": "node packages/agent-eval/src/bin/agent-eval.ts",
    "pg:local": "node packages/db/src/bin/local-pg.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/node": "^22.20.4",
    "esbuild": "0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1",
    "yaml": "^2.9.1"
  }
}
