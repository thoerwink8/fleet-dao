{
  "name": "fleet-dao",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=22.22"
  },
  "scripts": {
    "check": "biome check . && tsc -b && vitest run && node packages/hygiene/src/bin/check.ts",
    "hygiene": "node packages/hygiene/src/bin/check.ts",
    "prepare": "node packages/hygiene/src/bin/install-hooks.ts",
    "format": "biome check --write .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "agents:sync": "node packages/agents-sync/bin/agents-sync-now",
    "mirasim:migrate": "node packages/mirasim-reclaude/bin/migrate",
    "test:changed": "node packages/conventions/src/bin/test-changed.ts",
    "ci:timings": "node packages/conventions/src/bin/ci-timings.ts",
    "ci:stats": "node packages/conventions/src/bin/ci-stats.ts",
    "issue:new": "node packages/conventions/src/bin/issue-new.ts",
    "issue:close": "node packages/conventions/src/bin/issue-close.ts",
    "debt:check": "node packages/conventions/src/bin/debt-check.ts",
    "plan": "node packages/conventions/src/bin/plan.ts",
    "github:audit": "node packages/conventions/src/bin/github-audit.ts",
    "branch:hygiene": "node packages/conventions/src/bin/branch-hygiene.ts",
    "drill": "node packages/engine/src/bin/drill.ts",
    "publish:pr": "node packages/conventions/src/bin/publish-pr.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/node": "^22.20.4",
    "esbuild": "0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1",
    "yaml": "^2.9.1"
  }
}
