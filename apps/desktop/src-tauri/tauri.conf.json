{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fleet2",
  "version": "0.1.0",
  "identifier": "com.fleet2.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Fleet2",
        "width": 1280,
        "height": 820,
        "minWidth": 320,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "resources": {
      "../build/kernel/": "kernel/",
      "../build/migrations/": "migrations/",
      "../build/web/": "web/",
      "../build/bin/jobrun.exe": "jobrun.exe"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"]
      }
    }
  }
}
