diff --git a/packages/engine/src/retry.ts b/packages/engine/src/retry.ts
index 1a2b3c4..5d6e7f8 100644
--- a/packages/engine/src/retry.ts
+++ b/packages/engine/src/retry.ts
@@ -1,12 +1,18 @@
 export interface RetryPolicy {
   attempts: number;
   baseMs: number;
 }

-export function delayFor(policy: RetryPolicy, attempt: number): number {
-  return policy.baseMs * attempt;
+/** 指数退避：第 n 次等 baseMs * 2^(n-1)，最多 60 秒。 */
+export function delayFor(policy: RetryPolicy, attempt: number): number {
+  return Math.min(60_000, policy.baseMs * 2 ** (attempt - 1));
 }

 export function shouldRetry(policy: RetryPolicy, attempt: number): boolean {
   return attempt < policy.attempts;
 }
