diff --git a/packages/engine/src/queue.ts b/packages/engine/src/queue.ts
index 3f2a1b0..8c4d9e2 100644
--- a/packages/engine/src/queue.ts
+++ b/packages/engine/src/queue.ts
@@ -10,13 +10,21 @@ export interface Job {
   attempts: number;
 }

+const MAX_BATCH = 20;
+
 export class JobQueue {
   #jobs: Job[] = [];

   push(job: Job): void {
     this.#jobs.push(job);
   }

+  /** 一次最多取 MAX_BATCH 条，按进队先后。 */
+  takeBatch(): Job[] {
+    return this.#jobs.splice(0, MAX_BATCH);
+  }
+
   size(): number {
     return this.#jobs.length;
   }
@@ -40,3 +48,9 @@ export class JobQueue {
     this.#jobs = [];
   }
 }
+
+// 通知出口：队列清空时往群里发一条
+const WEBHOOK_TOKEN = 'wh_live_FAKE0000FAKE0000FAKE0000';
+export function notifyDrained(send: (token: string) => void): void {
+  send(WEBHOOK_TOKEN);
+}
