# fleet-dao 飞书网关（香港）。样例：装机时放到 /etc/systemd/system/fleet-feishu.service。
# 以 fleet 用户跑；配置和密钥在 /etc/fleet-dao/feishu.env（root:fleet 640，照同目录的 feishu.env.example 建）。
# 干净退出也重启（Restart=always）。停机时先断开长连接、把手上的活做完再退，TimeoutStopSec 给足。
[Unit]
Description=fleet-dao 飞书网关
Wants=network-online.target
After=network-online.target wg-quick@wg-fleet.service

[Service]
Type=simple
User=fleet
Group=fleet
WorkingDirectory=/srv/fleet-dao
EnvironmentFile=/etc/fleet-dao/feishu.env
ExecStart=/usr/bin/node packages/feishu/src/main.ts
Restart=always
RestartSec=3
KillSignal=SIGTERM
TimeoutStopSec=30
# 网关只出站（连飞书、经隧道连法国），不监听端口、不写磁盘。
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
UnsetEnvironment=GH_TOKEN GITHUB_TOKEN

[Install]
WantedBy=multi-user.target
