# fleet-dao 飞书网关（香港）的本机配置样例。照这份建 /etc/fleet-dao/feishu.env（root:fleet 640），填好再起服务；
# 不进 git，这里只有占位符。改完 systemctl restart fleet-feishu。
#
# 飞书开发者后台（新建一个企业自建应用，别复用旧机器人的：同一个应用连两个长连接，事件会被随机分走）：
# - 开机器人能力；事件订阅和回调订阅都选「长连接」。
#   事件：im.message.receive_v1、application.bot.menu_v6；回调：card.action.trigger。
# - 权限：im:message.p2p_msg:readonly、im:message.group_at_msg:readonly、im:message:send_as_bot、
#   im:message.reactions:write_only、im:chat.top_notice:write_only。
# - 机器人自定义菜单（悬浮菜单，动作选「推送事件」），event_key 要一字不差：
#   盘面 = board，我的待办 = todo，新任务 = new_task，查进度 = progress
# - 可用范围：两位创始人 + 端到端自测用的测试身份。
# - 每改一次权限、事件、回调、菜单都要「创建版本并发布」，否则不生效。

# 应用凭据（开发者后台「凭证与基础信息」）
FEISHU_APP_ID=<cli_开头的 App ID>
FEISHU_APP_SECRET=<App Secret>

# 调后端的通行证：和法国 /etc/fleet-dao 里后端的 FLEET_FEISHU_GATEWAY_TOKEN 同一个值（至少 32 个字符）
FLEET_FEISHU_GATEWAY_TOKEN=<网关通行证>
# 驾驶舱后端，经隧道：法国的 WireGuard 地址和后端端口（见 docs/ops.md 的端口表）
FLEET_BACKEND_URL=http://<法国的隧道地址>:8787
# 驾驶舱在浏览器里的地址：卡片上的「打开驾驶舱」跳这里
FLEET_PUBLIC_URL=https://fleetdao.dpdns.org

# 团队群的 chat_id（oc_ 开头）：置顶盘面卡、三类推送都发这里
FEISHU_TEAM_CHAT_ID=<团队群 chat_id>
# 端到端自测用的测试群（oc_ 开头，可不填）：能在里面记任务、问进度，不放盘面卡、不收推送
FEISHU_TEST_CHAT_ID=
# 创始人白名单，open_id:显示名，逗号分隔。只替这几位办事，别人礼貌拒绝
FEISHU_FOUNDERS=<甲的 open_id:甲,乙的 open_id:乙>

# 下面几项可不填，用默认值
# 收到消息先加的表情（飞书 emoji_type）
FEISHU_ACK_EMOJI=Get
# 每天最多发几张「求人」的卡（要人拍 + AI 追问）；超了只发一张提醒，其余只进驾驶舱
FEISHU_ASK_BUDGET_PER_DAY=10
# 盘面快照多久取一次（秒）
FEISHU_BOARD_REFRESH_SECONDS=30
