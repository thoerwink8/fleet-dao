#!/usr/bin/env bash
# 法国上后端的管理命令（docs/ops.md 第九节「账密登录」「让 AI 接活」）：以 root 跑，
#   bash /srv/fleet-dao-releases/current/packages/api/bin/fleet-api set-password <飞书名或用户 id> [--username <用户名>]
#   bash /srv/fleet-dao-releases/current/packages/api/bin/fleet-api dispatch <owner/仓名> on|off|status
#   bash /srv/fleet-dao-releases/current/packages/api/bin/fleet-api dispatch-issue <owner/仓名> <单号> [--force --note "<为什么>"]   开关关着时点名派一张单
#   bash /srv/fleet-dao-releases/current/packages/api/bin/fleet-api groom <owner/仓名> [--note "<为什么>"]   叫一次临时指挥官整理待办（只排队，引擎几秒内接手）
#   bash /srv/fleet-dao-releases/current/packages/api/bin/fleet-api usage-backfill-once [--apply]   一次性回填没有会话号的老用量（默认只读）
#   bash /srv/fleet-dao-releases/current/packages/api/bin/fleet-api task continue|abandon|redo <owner/仓名> <单号> --note "<为什么>"   续、放弃、重做一张单
#   bash /srv/fleet-dao-releases/current/packages/api/bin/fleet-api feishu-push status|test   提醒推飞书通不通；test 建一条测试提醒等它推出去
#   bash /srv/fleet-dao-releases/current/packages/api/bin/fleet-api daily-brief [--as-today]   手动跑一次每日简报（推飞书、#1055 评论）
#   bash /srv/fleet-dao-releases/current/packages/api/bin/fleet-api attention --json   只读：现在要人看的事一份结论（healthz、该推的通知、推送不通、简报没到），指挥官巡检读它
#   bash /srv/fleet-dao-releases/<版本>/packages/api/bin/fleet-api release pause|continue …   发版切版本前后暂停、继续手上有会话的任务（release.sh 调，名单走标准输出、标准输入）
#   bash /srv/fleet-dao-releases/current/packages/api/bin/fleet-api project show <owner/仓名>   只读：仓号和仓档案（JSON）
#   bash /srv/fleet-dao-releases/current/packages/api/bin/fleet-api project set-profile <owner/仓名> --file <json 文件|->   整份换掉仓档案（- 读标准输入）
#   bash /srv/fleet-dao-releases/current/packages/api/bin/fleet-api emergency-issue --key <键> --title "<标题>" [--json] < 正文.md   开急修单（自动发布在同一个提交发版连败时调，#2728）
#   bash /srv/fleet-dao-releases/current/packages/api/bin/fleet-api notify raise --key <键> --title "<标题>" [--level alert|daily] [--link </路径>] < 正文   记一条提醒（发版脚本写卡住报警的统一入口，#2729）
#   bash /srv/fleet-dao-releases/current/packages/api/bin/fleet-api seat|claim …   帅位只一个（#299）：本机经 ssh 调，写法见 seat --help
# 换成 fleet 身份、带上 fleet-api.service 同一份 /etc/fleet-dao/api.env（连库用的 DATABASE_URL、PGHOST 这些）去跑：
# 库只认 fleet 这个本机用户（peer 认证），环境文件按 systemd 的读法读、和服务读同一组（清单取自 deploy/france/fleet-api.service）。
# 标准输入是终端就给它一个伪终端（--pty：密码不回显），是管道就原样接过去（--pipe：脚本里用）。
# 换了身份就看不出是谁跑的了：先把 root（经 sudo 跑的记 sudo 前的用户）交给命令，写进操作记录。
set -euo pipefail
if [[ $EUID -ne 0 ]]; then
  echo "要以 root 跑（它会换成 fleet 身份连库）" >&2
  exit 2
fi
root=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../../.." && pwd)
if [[ -t 0 ]]; then io=--pty; else io=--pipe; fi
# dispatch-issue（#1337，开关关着时点名派单）的本体在引擎包：准入用的交代解析、分档、拉单装配都在那边，驾驶舱后端不依赖引擎包。
# 其余命令都是后端自己的。
entry="$root/packages/api/src/bin/fleet-api.ts"
if [[ "${1:-}" == "dispatch-issue" ]]; then
  entry="$root/packages/engine/src/bin/dispatch-issue.ts"
  shift
# groom（#1338，叫一次临时指挥官整理待办）的本体同样在引擎包：判能不能叫、记「点了」的逻辑和引擎拉单自己叫是同一份
elif [[ "${1:-}" == "groom" ]]; then
  entry="$root/packages/engine/src/bin/groom.ts"
  shift
# usage-backfill-once（#1948，一次性回填没有会话号的老用量）的本体同样在引擎包
elif [[ "${1:-}" == "usage-backfill-once" ]]; then
  entry="$root/packages/engine/src/bin/usage-backfill-once.ts"
  shift
# daily-brief（决定 0096，手动跑一次每日简报）的本体同样在引擎包：收集、写法和引擎定时那一轮是同一份
elif [[ "${1:-}" == "daily-brief" ]]; then
  entry="$root/packages/engine/src/bin/daily-brief.ts"
  shift
fi
# 环境文件照同一版的 fleet-api.service 一行行搬过来（顺序、「-」都照抄）：只写 api.env 时，session-mint 读不到
# session-secret.env 里的会话密钥（#1800 上线后第一次跑就碰上）。单元文件读不到、一条都没有就停，不拿半份环境去跑。
unit="$root/deploy/france/fleet-api.service"
env_args=()
if [[ -r "$unit" ]]; then
  while IFS= read -r line; do
    env_args+=(-p "$line")
  done < <(grep -E '^EnvironmentFile=' "$unit")
fi
if [[ ${#env_args[@]} -eq 0 ]]; then
  echo "读不到 $unit 里的 EnvironmentFile=，没跑" >&2
  exit 1
fi
exec systemd-run --quiet --wait --collect "$io" --uid=fleet --gid=fleet \
  "${env_args[@]}" -p WorkingDirectory="$root" \
  -E FLEET_OPS_OPERATOR="${SUDO_USER:-root}" \
  /usr/bin/node "$entry" "$@"
