{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/agents/hooks/bootstrap.mjs\"",
            "timeout": 120
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/agents/hooks/session-start.mjs\"",
            "timeout": 90
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/agents/hooks/main-thread.mjs"],
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/agents/hooks/continuation-progress.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/agents/hooks/stop.mjs\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/agents/hooks/work-watch.mjs\"",
            "timeout": 11400,
            "asyncRewake": true,
            "rewakeMessage": "工人钩子（work-watch.mjs）：下面是 pnpm work run 派出去的本机工人到了终态（做完、没做成、或看护进程没了）。给创始人报一行，再按结果接着派下一件、或修、或 pnpm work run <单号> 续：",
            "rewakeSummary": "本机工人到终态，已叫醒主线程"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/agents/hooks/prompt-log.mjs\"",
            "timeout": 30
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/agents/hooks/quota-stop.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
