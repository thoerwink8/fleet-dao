# 指挥官登录法国会话用户（#1775 / #1795）。User 必须是 fleet-agent-carpool，不要用 root
# （/etc/ssh/authorized_keys/ 只给会话用户装了钥匙；root 另一套，box 上的 myserver/grok_bot 对不上就会 Permission denied）。
#
# 私钥：法国认的是 pilot 同步过来的两把（指纹见 deploy/france/session-login.pub）：
#   SHA256:jGF0jPb1smqw9FG0wcvX3ouPTcTA+qTY/Uzl1QN44e0  administrator@DESKTOP-GET3DBC (RSA)
#   SHA256:+W2XnLuoM6r0sqFJ+HxZHoPfhcCuJMggzr3iBUuNDTI  fleet-dao@desktop-2026-09-30-v2 (ED25519)
# 本机/box 上把匹配指纹的私钥放到下面 IdentityFile 之一即可；没有 fleet_login 时用 id_ed25519 / id_rsa。
# 一键对照指纹并写 symlink：bash deploy/france/install-commander-login.sh
#
# IdentitiesOnly：法国 MaxAuthTries 3。钥匙多于 3 把还不写 IdentitiesOnly，还没轮到对的那把就 Too many authentication failures。

Host fleet-fr-carpool
	HostName 13.140.184.255
	User fleet-agent-carpool
	IdentitiesOnly yes
	IdentityFile ~/.ssh/fleet_login
	IdentityFile ~/.ssh/id_ed25519
	IdentityFile ~/.ssh/id_rsa
	PubkeyAuthentication yes

# 经香港跳板（本机已有 myserver 别名时）：
Host fleet-fr-carpool-via-hk
	HostName 10.99.0.2
	User fleet-agent-carpool
	ProxyJump myserver
	IdentitiesOnly yes
	IdentityFile ~/.ssh/fleet_login
	IdentityFile ~/.ssh/id_ed25519
	IdentityFile ~/.ssh/id_rsa
	PubkeyAuthentication yes
