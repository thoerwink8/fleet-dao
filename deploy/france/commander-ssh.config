# 指挥官本机 ~/.ssh/config 片段（#1775 / #1795）：恢复一条能登进法国会话用户的路。
# 用法：把下面 Host 块并进本机 ~/.ssh/config（或 Include 本文件）。私钥放本机 ~/.ssh/fleet_login（600），
# 公钥须已在法国 /etc/ssh/authorized_keys/fleet-agent-carpool（france.sh 照 pilot 的 authorized_keys 写）。
#
# 为什么要 IdentitiesOnly：法国 MaxAuthTries 3（deploy/france/sshd-hardening.conf）。本机 agent 里钥匙多于 3 把、
# 又不写 IdentitiesOnly 时，还没轮到对的那把就会 Permission denied（Too many authentication failures）。
# 登录用户必须是会话用户 fleet-agent-carpool（#1785 后家里 ~/.ssh 不再生效），不要用 root 试这条路。

Host fleet-fr-carpool
	HostName 13.140.184.255
	User fleet-agent-carpool
	IdentitiesOnly yes
	IdentityFile ~/.ssh/fleet_login
	PubkeyAuthentication yes

# 经香港跳板（本机已有 myserver 别名时）：
Host fleet-fr-carpool-via-hk
	HostName 10.99.0.2
	User fleet-agent-carpool
	ProxyJump myserver
	IdentitiesOnly yes
	IdentityFile ~/.ssh/fleet_login
	PubkeyAuthentication yes
