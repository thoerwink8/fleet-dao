# fleet-dao 驾驶舱后端（fleet-api.service）的本机配置：deploy/france.sh 第一次跑时照这份建 /etc/fleet-dao/api.env
# （root:fleet 640），之后只读不写。改完重新发布一次（bash deploy/release.sh）就会重启后端。不进 git。
# 随机生成的密钥不写在这里：FLEET_SESSION_SECRET、FLEET_AGENT_TOKEN_SECRET、FLEET_FEISHU_GATEWAY_TOKEN 由 france.sh 首次生成，
# 各在一个文件里（session-secret.env、agent-token.env、gateway-token.env），单元把它们一起读进来。
FLEET_ENV=production
# 浏览器看到的驾驶舱地址（香港的域名）。这里是样例，真域名只写在机器上的配置里，公开仓不写
FLEET_PUBLIC_URL=https://cockpit.example.com
# 驾驶舱接口只听隧道地址：香港经 WireGuard 转进来，公网上没有这个端口
FLEET_COCKPIT_LISTEN=10.99.0.2:8787
# fleet 命令接口只听本机回环：AI 会话在同一台机器上调
FLEET_AGENT_LISTEN=127.0.0.1:8788
# 本机库：走 unix socket + peer 认证（系统用户 fleet 就是库角色 fleet），没有口令。
# 连接串里不写主机，主机由 PGHOST 给（postgres.js 不认连接串里 ?host= 的写法）
DATABASE_URL=postgres:///fleet
PGHOST=/var/run/postgresql
PGUSER=fleet
# GitHub App 设置页里的 Webhook secret（/etc/fleet-dao/github/ 里那个收事件的 App 的 json 有 webhook_secret）。生产必填
FLEET_GITHUB_WEBHOOK_SECRET=
# 飞书自建应用的凭据（飞书开放平台）。生产必填：没配后端起不来
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 演示版的可见范围发布在这里（france.sh 建的目录，后端的单元只放行它可写）：驾驶舱「演示版」页发的链接、默认范围
# 写进 scopes/，由 fleet-demo-scopes 推到香港。空着 = 发不了演示链接（驾驶舱照实说没配），演示版照常按最严的范围给人看
FLEET_DEMO_DIR=/var/lib/fleet-dao/demo
# 免登 FLEET_DEV_LOGIN 在这台永远不开：驾驶舱接口听的不是回环地址，/auth 会被香港转到公网（后端也会拒绝启动）
