# fleet-dao 驾驶舱后端：一个进程两个监听——驾驶舱接口（隧道地址 10.99.0.2:8787，香港经它转 /api、/auth、
# /github/webhook、/healthz）与 fleet 命令接口（127.0.0.1:8788，只给本机的 AI 会话）。
# deploy/release.sh 从要发布的那个提交里取这份，装到 /etc/systemd/system/；改这份、再发布一次，别在机器上手改。
# 本机配置：/etc/fleet-dao/api.env（每一项应该是什么在仓里的 deploy/france/desired-config.json），密钥在 france.sh 生成的三个文件里。
[Unit]
Description=fleet-dao 驾驶舱后端（驾驶舱接口 + fleet 命令接口）
Documentation=https://github.com/thoerwink8/fleet-dao/blob/main/docs/ops.md
# 端口归 fleet-api.socket 攥着（它 FreeBind，隧道没起也能先听上）。没装那个单元的机器用的是没有 Requires 这行的旧单元，
# 服务自己 bind。退回到不带 socket 的版本时，发布脚本先撤 socket 再换回旧单元，不会留着 Requires 去等一个不存在的单元。
Requires=fleet-api.socket
# 服务本身仍等隧道、库、Temporal：读配置、连库要等它们就绪。After 最前面是 socket，端口先被攥住再起进程。
After=fleet-api.socket network-online.target wg-quick@wg-fleet.service postgresql@16-main.service fleet-temporal.service
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=fleet
Group=fleet
WorkingDirectory=/srv/fleet-dao-releases/current
EnvironmentFile=/etc/fleet-dao/agent-token.env
EnvironmentFile=/etc/fleet-dao/session-secret.env
EnvironmentFile=/etc/fleet-dao/gateway-token.env
# release.env 的 FLEET_SERVICES 说本机开不开引擎：没开，/healthz 的 engine 项报「未接」而不是红（packages/api/src/config.ts 的
# engineEnabled）。放在 api.env 前面：同名的键以后读的为准。前面的「-」：机器上没有这个文件也照样起，按开着算（多报红、不漏报）
EnvironmentFile=-/etc/fleet-dao/release.env
EnvironmentFile=/etc/fleet-dao/api.env
ExecStart=/usr/bin/node /srv/fleet-dao-releases/current/packages/api/src/main.ts
Restart=always
RestartSec=5
TimeoutStopSec=30
LimitNOFILE=65536
# 后端不起子进程，可以收紧（引擎不行，见 fleet-engine.service）
NoNewPrivileges=yes
ProtectSystem=strict
# 能写的地方：「发布到法国」按钮的请求目录（人工档装，见 deploy/lib/human-tier.sh；root 的 path 单元盯着它）。
# 前面的「-」：目录还没建时照样起得来，只是发布按钮置灰（驾驶舱里照实报没配好）。
# 进度目录 /srv/fleet-dao-releases/.train 归 root，后端只读
ReadWritePaths=-/var/lib/fleet-dao/release-request
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
