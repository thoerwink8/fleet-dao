# fleet-dao 引擎工人（Temporal worker）。deploy/release.sh 从要发布的那个提交里取这份，装到 /etc/systemd/system/；
# 代码在 /srv/fleet-dao-releases/current（归 root，fleet 只读）。改这份、再发布一次，别在机器上手改。
# 本机配置：/etc/fleet-dao/engine.env（样例 deploy/france/engine.env.example）、agent-token.env（france.sh 生成）。
[Unit]
Description=fleet-dao 引擎工人（Temporal worker）
Documentation=https://github.com/thoerwink8/fleet-dao/blob/main/docs/ops.md
After=network-online.target fleet-temporal.service postgresql@16-main.service
Wants=network-online.target
# Temporal 长时间起不来也一直重试，不在几次失败后放弃
StartLimitIntervalSec=0

[Service]
Type=simple
User=fleet
Group=fleet
WorkingDirectory=/srv/fleet-dao-releases/current
EnvironmentFile=/etc/fleet-dao/agent-token.env
EnvironmentFile=/etc/fleet-dao/engine.env
ExecStart=/usr/bin/node /srv/fleet-dao-releases/current/packages/engine/src/main.ts
# always：干净退出也拉起来，on-failure 不管这种情况
Restart=always
RestartSec=5
# 停机先排空（packages/engine/src/drain.ts）：收到 SIGTERM 不起新会话，在跑的最多再做 10 分钟宽限，到点停下（新引擎起来按编号
# 续上），等交回最多 2 分钟，工人再给在途活动 30 秒收尾（FLEET_SHUTDOWN_GRACE_SECONDS）。第二次 SIGTERM 马上停。
# 会话脱开引擎跑（/var/lib/fleet-sessions，docs/ops.md 第九节「发布不碰会话」）时不等也不停它们：新引擎起来接回；宽限只剩
# 还接着管道的旧会话用得上。
# mixed：停机信号只发给引擎主进程；默认的 control-group 会把 SIGTERM 发给引擎 cgroup 里每个 sudo，sudo 原样转给会话，会话当场
# 就死（2026-09-27 19:28:51、20:46:26 两次发布都这样白杀了在干的活）。主进程退了，剩下的（sudo）才收 SIGKILL。
KillMode=mixed
# 盖住宽限 + 等交回 + 工人收尾，再留余量；改宽限要一起改（packages/engine/test/drain.test.ts 核对）
TimeoutStopSec=15min
LimitNOFILE=65536
# 不开 NoNewPrivileges：引擎经 sudo 调 fleet-agent-scope 起 AI 会话，sudo 是 setuid 程序，开了就提不了权。
# 也不开 ProtectSystem、ProtectHome、PrivateTmp 这类挂载隔离和能力收缩：会话是引擎的子进程，挪进自己的 scope 也还在
# 引擎的挂载空间里，开了会话就看不见自己的家目录、写不了工作树。会话的隔离靠会话用户、nft 表和 scope 的上限（docs/ops.md 第五节）。

[Install]
WantedBy=multi-user.target
