# 每 10 分钟量一轮各目录的磁盘占用（fleet-footprint.service，#3456）。france.sh 装。
# 停它：systemctl disable --now fleet-footprint.timer（资源页的磁盘会在 20 分钟后标「旧数」，再往后写「没读到」）。
[Unit]
Description=fleet-dao 每 10 分钟按目录量一轮磁盘占用

[Timer]
# 只写 OnUnitInactiveSec 的定时器在服务一次都没跑过时永远不响：装上 1 分钟后先量一轮
OnActiveSec=1min
# 上一轮跑完 10 分钟再来（按「跑完之后」算，不叠着跑）
OnUnitInactiveSec=10min
AccuracySec=30s
Unit=fleet-footprint.service

[Install]
WantedBy=timers.target
