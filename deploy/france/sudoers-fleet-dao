# fleet-dao（deploy/france.sh 装到 /etc/sudoers.d/fleet-dao，root 440，装之前先过 visudo -c；别在机器上手改）。
# 引擎用户 fleet 只能以 root 跑这一个脚本：它把 AI 会话以会话专用用户的身份放进 fleet-agents.slice 下自己的 scope，或收掉一个。
# 会话要的环境变量经 env_keep 放过去（不上命令行）；GitHub 凭据一概不放。不开伪终端，会话的标准输入输出原样接回引擎。
Defaults!/usr/local/sbin/fleet-agent-scope !use_pty, env_keep += "FLEET_* LANG LANGUAGE LC_* TZ TERM GIT_TERMINAL_PROMPT"
fleet ALL=(root) NOPASSWD: /usr/local/sbin/fleet-agent-scope
# 监督经 fleet-fr-carpool（会话用户）SSH 登入后做最小引擎恢复（#1773、#1775）：只放行在用版本上的 fleet-api，
# 且只许 engine 子命令（status / on / off）。AI 会话跑在 fleet-agents.slice 里带 no_new_privs，sudo 提权仍被内核挡住；
# 外面 SSH 进来的登录 shell 没有那面旗，才能跑这些。不给改密、dispatch 等别的子命令。
fleet-agent-carpool ALL=(root) NOPASSWD: /srv/fleet-dao-releases/current/packages/api/bin/fleet-api engine status, /srv/fleet-dao-releases/current/packages/api/bin/fleet-api engine on *, /srv/fleet-dao-releases/current/packages/api/bin/fleet-api engine off *
