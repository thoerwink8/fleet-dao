# fleet-dao 演示版的可见范围推到香港：跑 /usr/local/sbin/fleet-demo-scopes（deploy/france/fleet-demo-scopes.sh）。
# 由 fleet-demo-scopes.path（范围目录一变）和 fleet-demo-scopes.timer（每 10 分钟补一次）拉起。france.sh 装，别在机器上手改。
# 以 root 跑：往香港传文件的钥匙只有 root 读得到。只读本机、只往香港推，其余一律收紧。
[Unit]
Description=fleet-dao 演示版的可见范围推到香港
Documentation=https://github.com/thoerwink8/fleet-dao/blob/main/docs/ops.md
After=network-online.target wg-quick@wg-fleet.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/fleet-demo-scopes
# 要比脚本最坏跑的时间长：等锁 120 秒 + 5 轮 ×（ssh 连上 10 秒 + rsync 没动静就停 30 秒）= 320 秒，再留余量；
# 短了 systemd 会先把它杀掉，报不出「等锁超时」，刚拿到锁也来不及推完（deploy/test/demo-scopes.test.sh 核对）
TimeoutStartSec=420
ProtectSystem=strict
# 往香港推之前要拿 /run/lock/fleet-dao-hk-rsync.lock（和发布脚本排同一个队，见 fleet-demo-scopes.sh）
ReadWritePaths=/run/lock
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
