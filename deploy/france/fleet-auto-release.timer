# fleet-dao 自动发布每 5 分钟看一轮主线（fleet-auto-release.service）。france.sh 装。
# 停自动发布：systemctl disable --now fleet-auto-release.timer（后端的 /healthz 会在 20 分钟后标「自动发布没报到」）。
[Unit]
Description=fleet-dao 自动发布每 5 分钟看一轮主线

[Timer]
# 只写 OnUnitInactiveSec 的定时器在服务一次都没跑过时永远不响：装上 2 分钟后先跑一轮
OnActiveSec=2min
# 上一轮跑完 5 分钟再来（一轮里可能在发布，按「跑完之后」算，不叠着跑）
OnUnitInactiveSec=5min
RandomizedDelaySec=30s
Unit=fleet-auto-release.service

[Install]
WantedBy=timers.target
