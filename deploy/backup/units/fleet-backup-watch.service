# fleet-dao 磁盘与备份巡检。deploy/backup/install.sh 装到 /etc/systemd/system/；改这份、再跑一遍装机脚本，别在机器上手改。
[Unit]
Description=fleet-dao 磁盘用量（法国、香港）与备份新鲜度巡检
Documentation=https://github.com/thoerwink8/fleet-dao/blob/main/docs/ops.md
Wants=network-online.target
After=network-online.target postgresql.service wg-quick@wg-fleet.service

[Service]
Type=oneshot
User=fleet
Group=fleet
ExecStart=/usr/local/lib/fleet-dao/backup/fleet-backup.sh watch
# 每小时跑一次，没做成等下一小时，不另外重试
TimeoutStartSec=10min
Nice=10
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
ReadWritePaths=/var/lib/fleet-dao/backup
