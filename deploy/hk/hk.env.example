# fleet-dao 香港机器的本机配置：deploy/hk.sh 第一次跑时照这份建 /etc/fleet-dao/hk.env（root:fleet 640），之后只读不写。
# 不进 git。改完再跑一遍 hk.sh 生效。
# 驾驶舱入口的域名。留空 = 站点用占位名 fleet-dao.invalid、不申请证书。
# 这里是样例，真域名只写在机器上的配置里，公开仓不写
FLEET_DOMAIN=cockpit.example.com
# 申请证书时的联系邮箱，可留空：机器上已有证书账号时用不到。
FLEET_ACME_EMAIL=
# 法国机器的 WireGuard 公钥：在法国跑 deploy/france.sh 时会打印出来。
FLEET_WG_FRANCE_PUBLIC_KEY=
# 法国发布脚本往 /srv/fleet-dao-web 传驾驶舱静态文件用的公钥（ssh-ed25519 开头的一整行）：法国跑 france.sh 时会打印出来。
FLEET_WEB_UPLOAD_PUBLIC_KEY=
# 法国发布脚本发飞书网关用的公钥（另一把，ssh-ed25519 开头的一整行）：法国跑 france.sh 时会打印出来。
FLEET_GATEWAY_DEPLOY_PUBLIC_KEY=
